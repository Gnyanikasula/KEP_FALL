# The runtime image needs: kep_fall/ + chroma_db/ + requirements.txt. Nothing else.

.git/
.github/
.gitignore
*.md
docs/
tests/
scripts/

# Build-time data — Phases A/B/C/E. The engine reads only chroma_db and Neo4j.
data/
results/

# Runtime databases are created on startup, never baked in.
*.db
*.db-wal
*.db-shm

# Secrets
.env
*.env.*

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/